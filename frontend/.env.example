# Only needed when deploying. For local dev, leave this file absent/unused —
# frontend/src/api.js defaults to http://localhost:4000/api automatically.
#
# When deployed, copy this to `.env.production` (or set the variable in your
# hosting provider's dashboard) and point it at your deployed backend:
VITE_API_URL=https://your-backend-url.onrender.com/api
